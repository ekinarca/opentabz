// Technique and tablature switches — original music written for OpenTabz (AGPL-3.0-or-later).
// An arpeggio and a strum, a trill, a slide, a note tied in mid-bar, quarter rests, palm mutes
// either side of a rest, and a second voice.
\title "Technique Switches"
\subtitle "OpenTabz test score"

\track ("Guitar" "Gt.") {instrument acousticguitarsteel}
\staff {score tabs}
\tuning (E4 B3 G3 D3 A2 E2)
\ts (4 4)
\voice
:4 (0.6 2.5 2.4){au} (0.6 2.5 2.4){bu} :8 5.3{sl} 7.3 :4 3.3{tr (5 16)} | :2 7.3 -.3 | :4 5.3 r 7.3 r | :8 5.6{pm} r 5.6{pm} 5.6{pm} :2 r |
\voice
:2 0.6 3.6 | :1 0.6 | :1 0.6 | :1 0.5 |
